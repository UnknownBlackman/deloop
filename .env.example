# TESTNET ONLY. Copy to .env (gitignored) and fill in.
# A testnet account with ~25 NEAR (faucet: https://near-faucet.io)
NEAR_ACCOUNT_ID=example.testnet
# Full-access key of that account, "ed25519:..."  (never commit this)
NEAR_PRIVATE_KEY= 
# Optional
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# DELOOP_CONTRACT_ID=deloop.yourname.testnet

# Optional LLM invoice reader (any OpenAI-compatible API, e.g. NEAR AI Cloud).
# Without these, the regex reader is used.
# LLM_BASE_URL=https://cloud-api.near.ai/v1
# LLM_API_KEY=
# LLM_MODEL=
